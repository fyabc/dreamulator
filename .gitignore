# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
_cache/
koppen_obs.json

# Node.js (frontend)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Project specific
data/worlds/*/simulations/
*.log
/private/
.env

# User-created worlds (the getting-started tutorial has every reader create one
# under data/worlds/) are local content, not repo content.  Only the canonical
# shipped worlds are tracked — add a negation here when a new world goes canonical.
data/worlds/*
!data/worlds/earth/
!data/worlds/nacrea/

# Claude Code
.claude/settings.local.json
.claude/notes/
private/plans/video/

# Generated terrain command record (machine-specific, not for publishing)
data/**/maps/*/generation_command.json
data/**/build_profile.json

# Validation reports (regeneratable via scripts/validate_climate.py)
reports/

# Headless map-layer export artifacts (diagnostic, regeneratable via `dreamulator export`)
export/

# Raw reference data downloads (use scripts to re-download)
*.grd
*.grd.gz

# Generated world build output — published to a GitHub Release by
# scripts/publish_world_data.py and downloaded by deploy-pages.yml, so it is
# NOT committed (no git LFS). Rebuild locally in data/worlds + publish.
data/worlds/**/maps/
data/worlds/**/derived/
# Pinned GCM field sets of frozen-climate branches (tens of MB): shipped with the
# worlds-data release; the small .provenance.json next to each stays in git.
data/worlds/*/branches/*/layers/climate/input/gcm_fields.msgpack.gz

# Dev-data package artifacts (tarballs); the committed index lives at
# data/dev-data/index.json and is NOT ignored.
data/dev-data/artifacts/

# Earth–Nacrea bridging counterfactual branches (diagnostic, regeneratable via
# scripts/climate/build_bridge_branches.py; not authored worlds).
data/worlds/earth/branches/bridge-*/
data/worlds/nacrea/branches/bridge-*/

# Import artifacts (duplicates of maps/, staging area for import-elevation)
layers/geological/input/maps/

# Backup files
*.bak
/rebound.html
